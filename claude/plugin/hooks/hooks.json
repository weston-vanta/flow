{
  "description": "Records Session facts in the flow Store through `flow hook`.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/efs-home/flow/bin/flow hook || true", "timeout": 5 }] }
    ]
  }
}
